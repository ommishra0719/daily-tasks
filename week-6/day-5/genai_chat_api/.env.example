APP_NAME=GenAI Authenticated Chat API
APP_VERSION=1.0.0
ENV=development
DEBUG=True

# Generate a real random value for every environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list, no spaces required
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=sqlite+aiosqlite:///./genai_chat.db

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MAX_CONTEXT_MESSAGES=10
MAX_CONTEXT_TOKENS=6000

RATE_LIMIT_MESSAGE=20/minute
RATE_LIMIT_AUTH=10/minute
